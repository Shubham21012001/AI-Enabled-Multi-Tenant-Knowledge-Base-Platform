# Copy to the repo root as .env.production and fill in. NEVER commit the real file.

# Public hostname (DNS A record must point at the EC2 instance)
DOMAIN=knowbot.example.com
FRONTEND_URL=https://knowbot.example.com
CORS_ORIGINS=https://knowbot.example.com

# Database / cache (internal network only) — use long random values
POSTGRES_USER=knowbot
POSTGRES_PASSWORD=
POSTGRES_DB=knowbot
REDIS_PASSWORD=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

AI_PROVIDER=openai
OPENAI_API_KEY=

# Uploaded documents. On EC2, prefer an IAM instance role over access keys.
STORAGE_BACKEND=s3
S3_BUCKET=knowbot-documents-prod
AWS_REGION=ap-south-1

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KnowBot <no-reply@knowbot.example.com>

LOG_LEVEL=INFO
