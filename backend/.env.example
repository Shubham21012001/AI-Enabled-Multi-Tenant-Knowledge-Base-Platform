# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+psycopg2://knowbot:knowbot_dev_password@localhost:5432/knowbot
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-env

# "openai" for real answers; "fake" runs offline (tests / no API key yet)
AI_PROVIDER=openai
OPENAI_API_KEY=

STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_BUCKET=
AWS_REGION=ap-south-1

EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KnowBot <no-reply@knowbot.local>
